PORT=3001
# Comma-separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:5173
# Leave empty to use built-in mock chatbot replies
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# --- eTMF tool (MongoDB) ---
MONGODB_URI=
# Long random string used to sign eTMF login tokens
JWT_SECRET=
# Only used to create the first admin when the users collection is empty
ETMF_ADMIN_EMAIL=
ETMF_ADMIN_PASSWORD=
# Set to true only on throwaway/demo databases (enables clear-data / reset-demo)
ETMF_ALLOW_DESTRUCTIVE=false
# Bind address. Use 127.0.0.1 in production when nginx is the public entry point
HOST=
# Chatbot providers, tried in this order: Gemini -> Groq -> OpenAI. Leave all empty for built-in replies
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
